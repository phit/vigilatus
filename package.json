{
  "name": "vigilatus",
  "version": "0.6.6",
  "private": true,
  "description": "Cross-platform desktop app for viewing Tapo cameras and local recordings.",
  "author": "phit",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron-compile\" \"npm:dev:electron-run\"",
    "dev:renderer": "vite",
    "dev:electron-compile": "tsc -p electron/tsconfig.json --watch",
    "dev:electron-run": "wait-on http-get://localhost:5173 file:dist/electron/main.js && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build": "vite build && tsc -p electron/tsconfig.json",
    "start": "electron .",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "package": "npm run build && electron-builder --dir",
    "release:win": "npm run build && electron-builder --publish never --win portable nsis",
    "release:linux": "npm run build && electron-builder --publish never --linux AppImage",
    "release:portable": "npm run build && electron-builder --publish never --win portable --linux AppImage",
    "release:publish": "npm run build && electron-builder --publish always --win portable nsis --linux AppImage",
    "probe:recordings": "npm run build --silent && node dist/electron/tools/recordingsProbe.js",
    "probe:playback": "npm run build --silent && node dist/electron/tools/playbackProbe.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "date-fns": "^4.2.1",
    "electron-updater": "^6.8.3",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "hls.js": "^1.7.0",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-electron-fs-backend": "^4.0.0",
    "lodash": "^4.18.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.8.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.6",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "link.phit.vigilatus",
    "productName": "Vigilatus",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/electron/**/*",
      "dist/renderer/**/*",
      "locales/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "${productName}-${version}-win-${arch}-portable.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    },
    "publish": {
      "provider": "github",
      "owner": "phit",
      "repo": "tapo-studio"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    }
  }
}

{
  "name": "tapostudio",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-platform desktop app for viewing Tapo cameras and local recordings.",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron-compile\" \"npm:dev:electron-run\"",
    "dev:renderer": "vite",
    "dev:electron-compile": "tsc -p electron/tsconfig.json --watch",
    "dev:electron-run": "wait-on http-get://localhost:5173 file:dist/electron/main.js && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build": "vite build && tsc -p electron/tsconfig.json",
    "start": "electron .",
    "package": "npm run build && electron-builder --dir",
    "release:win": "npm run build && electron-builder --publish never --win portable",
    "release:linux": "npm run build && electron-builder --publish never --linux AppImage",
    "release:portable": "npm run build && electron-builder --publish never --win portable --linux AppImage",
    "probe:recordings": "npm run build --silent && node dist/electron/tools/recordingsProbe.js",
    "probe:playback": "npm run build --silent && node dist/electron/tools/playbackProbe.js"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "hls.js": "^1.5.21",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^25.8.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.1.0",
    "cross-env": "^10.1.0",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "link.phit.tapostudio",
    "productName": "TapoStudio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/electron/**/*",
      "dist/renderer/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-win-${arch}-portable.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    }
  }
}
